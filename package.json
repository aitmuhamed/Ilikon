{
  "name": "ilikon-pharmacy",
  "version": "1.0.0",
  "private": true,
  "description": "Иликон (Уужим Эмийн Сан) — online pharmacy e-commerce platform & admin dashboard",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "setup": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "test:consultation": "tsx --conditions=react-server --env-file=.env scripts/consultation-smoke.ts",
    "test:consultation:e2e": "node scripts/consultation-e2e.mjs",
    "consultations:purge": "tsx --conditions=react-server --env-file=.env scripts/consultation-purge.ts",
    "rotate:passwords": "tsx --conditions=react-server --env-file=.env scripts/rotate-passwords.ts",
    "responsive:audit": "node scripts/responsive-audit.mjs",
    "test:crawl": "node scripts/crawl.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.474.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}

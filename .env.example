# ─────────────────────────────────────────────────────────────
# Иликон (Уужим Эмийн Сан) — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL)
DATABASE_URL="postgresql://ilikon:ilikon_dev_password@localhost:5439/ilikon?schema=public"

# Session / JWT signing secret — MUST be >= 32 chars, rotate in production.
# Generate: openssl rand -base64 48
AUTH_SECRET="change-me-in-production-min-32-characters-long-secret"

# Public site URL (used for SEO canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── File storage ─────────────────────────────────────────────
# STORAGE_DRIVER = local | s3
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage/uploads"

# S3-compatible storage (MinIO / AWS S3 / Cloudflare R2) — used when STORAGE_DRIVER=s3
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ── Chatbot ("Иликон") ───────────────────────────────────────
# Optional. When set, the chatbot augments its grounded pharmacy answers with
# an LLM. Server-side only — never expose to the browser.
ANTHROPIC_API_KEY=""
CHATBOT_MODEL="claude-sonnet-5"

# ── AI health consultation agent ─────────────────────────────
# Safety-critical triage reasoning — keep this on a frontier model.
CONSULTATION_MODEL="claude-opus-5"

# ── Payments (server-side secrets only) ──────────────────────
# Payment provider abstraction — fill in when a Mongolian gateway is contracted.
QPAY_USERNAME=""
QPAY_PASSWORD=""
QPAY_INVOICE_CODE=""
QPAY_BASE_URL="https://merchant.qpay.mn/v2"

CARD_GATEWAY_API_KEY=""
CARD_GATEWAY_BASE_URL=""

# Bank transfer details shown to the customer (non-secret)
BANK_TRANSFER_ACCOUNT="5xxx xxxx xx"
BANK_TRANSFER_BANK="Хаан банк"
BANK_TRANSFER_HOLDER="Иликон Уужим Эмийн Сан ХХК"

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="120"
